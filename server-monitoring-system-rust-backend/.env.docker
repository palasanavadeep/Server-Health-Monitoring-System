# Docker-specific environment — hostnames use Docker service names.
# Mirrors the Node.js docker-compose.yaml credentials and service names exactly.

NODE_ENV=production
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://mongo:27017/server_monitoring
MONGO_DB_NAME=server_monitoring

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=server_monitoring
PG_USER=postgres
PG_PASSWORD=npalasa

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://admin:admin@rabbitmq:5672/server_monitoring
RABBITMQ_QUEUE=server_hits
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=1000

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_strong_secret_in_production
JWT_EXPIRES_IN=24h

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Resilience ────────────────────────────────────────────────────────────────
RESILIENCE_CB_FAILURE_THRESHOLD=5
RESILIENCE_CB_COOLDOWN_MS=30000
RESILIENCE_CB_HALF_OPEN_ATTEMPTS=3
RESILIENCE_RETRY_MAX_DELAY_MS=30000
RESILIENCE_RETRY_JITTER_FACTOR=0.3

# ── Consumer ──────────────────────────────────────────────────────────────────
CONSUMER_STARTUP_MAX_RETRIES=5
CONSUMER_STARTUP_BASE_DELAY_MS=5000
CONSUMER_DB_CONNECT_MAX_RETRIES=5
CONSUMER_GRACEFUL_SHUTDOWN_SECS=2
CONSUMER_IDEMPOTENCY_CACHE_SIZE=100000
