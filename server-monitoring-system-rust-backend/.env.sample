# ─────────────────────────────────────────────────────────────────────────────
# server-monitoring-system — environment variable reference
# Copy this file to .env and fill in your values.
# Fields marked  *REQUIRED*  must be set — the app panics on startup without them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/server_monitoring
MONGO_DB_NAME=server_monitoring

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=server_monitoring
PG_USER=postgres
PG_PASSWORD=                  # *REQUIRED* — your local PostgreSQL password

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=server_hits
RABBITMQ_PUBLISHER_CONFIRMS=false
RABBITMQ_RETRY_ATTEMPTS=3
RABBITMQ_RETRY_DELAY=1000     # base delay in ms between publish retries

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=                   # *REQUIRED* — use a strong random secret in production
JWT_EXPIRES_IN=24h

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000    # rolling window in ms
RATE_LIMIT_MAX_REQUESTS=100   # max requests per window

# ── Resilience — Circuit Breaker & Retry ─────────────────────────────────────
# All optional — defaults are documented in src/config/settings.rs.
RESILIENCE_CB_FAILURE_THRESHOLD=5      # failures before circuit opens
RESILIENCE_CB_COOLDOWN_MS=30000        # ms circuit stays open before probing
RESILIENCE_CB_HALF_OPEN_ATTEMPTS=3     # successful probes to close the circuit
RESILIENCE_RETRY_MAX_DELAY_MS=30000    # upper bound on exponential backoff (ms)
RESILIENCE_RETRY_JITTER_FACTOR=0.3     # random jitter fraction applied to delay

# ── Consumer ──────────────────────────────────────────────────────────────────
# All optional — defaults are documented in src/config/settings.rs.
CONSUMER_STARTUP_MAX_RETRIES=5         # max consumer startup retry attempts
CONSUMER_STARTUP_BASE_DELAY_MS=5000    # base delay between startup retries
CONSUMER_DB_CONNECT_MAX_RETRIES=5      # max DB connection attempts on startup
CONSUMER_GRACEFUL_SHUTDOWN_SECS=2      # seconds to drain in-flight messages on shutdown
CONSUMER_IDEMPOTENCY_CACHE_SIZE=100000 # max message IDs held in dedup cache

# ── Misc ──────────────────────────────────────────────────────────────────────
VALID_API_KEYS=               # comma-separated admin API keys (optional)
